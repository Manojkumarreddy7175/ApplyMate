# ApplyMate Environment Variables
# Copy this file to .env and fill in your actual values

# Google AI API Key (for Gemini)
GOOGLE_API_KEY=your_google_api_key_here

# Firecrawl API Key (for web scraping)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# BrowserBase API Key (for browser automation)
BROWSERBASE_API_KEY=your_browserbase_api_key_here
BROWSERBASE_PROJECT_ID=your_browserbase_project_id_here

# Email Configuration (for notifications)
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_app_password_here

# Scheduled Automation Configuration (for time-triggered auto-apply)
RESUME_PATH=temp_resume.pdf
MAX_APPLICATIONS_PER_RUN=5

# Schedule Configuration (Optional - leave blank for defaults: 9 AM and 6 PM weekdays)
# To set custom schedule, uncomment and configure:
# SCHEDULE_HOUR=9
# SCHEDULE_MINUTE=0
# SCHEDULE_DAYS=mon-fri

# Mail Watcher Configuration (OPTIONAL - only if using email-triggered mode)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
POLL_INTERVAL=60
MAX_APPLICATIONS=3
MAIL_FILTER_SENDER=
MAIL_FILTER_SUBJECT=
MAIL_WATCHER_MODE=

# Optional: Debug mode
DEBUG=1


